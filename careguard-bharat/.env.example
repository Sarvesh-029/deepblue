# CareGuard Bharat - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# App Settings
APP_NAME=CareGuard Bharat
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./careguard.db

# Storage Configuration
STORAGE_BACKEND=local
LOCAL_SNAPSHOT_DIR=./data/snapshots
S3_BUCKET_NAME=
AWS_REGION=ap-south-1

# Face Recognition Service Backend
FACE_SERVICE_BACKEND=local
YUNET_MODEL_PATH=./models_data/face_detection_yunet_2023mar.onnx
SFACE_MODEL_PATH=./models_data/face_recognition_sface_2021dec.onnx
ENABLE_YOLO_PERSON_DETECTION=False

# Alerts Configuration
ALERT_BACKEND=inapp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Event Store Configuration
EVENT_STORE_BACKEND=sqlite

# Privacy and Retention Settings
SNAPSHOT_RETENTION_DAYS=7
DEFAULT_UNATTENDED_MINUTES=10
CAREGIVER_ABSENT_CHECK_MINUTES=30
FRAME_CAPTURE_INTERVAL_SECONDS=4
MAX_FRAME_WIDTH=640
